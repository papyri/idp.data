         <div xml:lang="grc" type="edition" xml:space="preserve"><div n="r" type="textpart" xml:id="_r"><head>r</head><ab>

    <lb n="1"/><g type="slanting-stroke"/> <g type="slanting-stroke"/> ἐν ὀνό<g type="apostrophe"/>ματι τοῦ θεοῦ. Κόρ<g type="apostrophe"/>ρα <expan>βε<ex>ν</ex></expan> Σζερὶ<g type="apostrophe"/>χ<g type="apostrophe"/> σύμβουλος 

    <lb n="2"/>Βασιλείῳ δι<g type="apostrophe"/>οι<g type="apostrophe"/>κητῇ κώμης Ἀφροδιτώ. εὐχαρ<g type="apostrophe"/>ιστοῦμε<unclear>ν</unclear> τ<supplied reason="lost">ῷ θεῷ</supplied> 

    <lb n="3"/>καὶ <g type="apostrophe"/>μετὰ ταῦτα<g type="apostrophe"/> <space extent="unknown" unit="character"/> Ἁειὰν<g type="apostrophe"/> <expan>βε<ex>ν</ex></expan> Σωρ<g type="apostrophe"/>άειγ ἀπήγγειλεν <unclear>ἡ</unclear><supplied reason="lost">μῖν περὶ</supplied> 

    <lb n="4"/>διαφόρ<g type="apostrophe"/>ων στί<g type="apostrophe"/>χων λ<g type="apostrophe"/>οιπαζομέ<unclear>ν</unclear>ω<supplied reason="lost">ν</supplied> διὰ τῆς διοικήσ<unclear>ε</unclear><supplied reason="lost">ώς σου</supplied> 

    <lb n="5"/>ἀπὸ τῶν διασταλέντων διʼ<g type="apostrophe"/> ἐνταγίων ἡμετέρ<g type="apostrophe"/>ων<g type="apostrophe"/> τῇ <supplied reason="lost"><app type="editorial"><lem resp="BL 6.122"><num value="8">ὀγδόῃ</num></lem><rdg><num value="7">ἑβδόμῃ</num></rdg></app><expan>ἰνδ<ex>ικτίονι</ex></expan></supplied> 

    <lb n="6"/><gap reason="lost" extent="unknown" unit="character"/><gap reason="illegible" quantity="4" unit="character"/><gap reason="illegible" quantity="4" unit="character"/><gap reason="illegible" quantity="1" unit="character"/>ε<gap reason="illegible" quantity="3" unit="character"/><gap reason="lost" extent="unknown" unit="character"/> 

    <lb n="7"/><gap reason="lost" extent="unknown" unit="line"/> 
</ab></div><div n="v" type="textpart" xml:id="_v"><head>v</head><ab>
