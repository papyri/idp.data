      <body><head><ref target="https://papyri.info/editions/p.oxy/14/1674" n="30505"><title>P.Oxy. 14 1674</title><date>1920</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><div n="ctr" type="textpart" xml:id="_ctr"><head>ctr</head><ab>

    <lb n="1"/>Θέων Ἀπολλωνίῳ υ<hi rend="diaeresis">ἱ</hi>ῷ χαίρειν. 

    <lb n="2"/>ἐπειδὴ οὐχ εὗρ<supplied reason="lost">ο</supplied>ν κρέας σοι πέμψαι, ἔπεμψα 

    <lb n="3"/>ᾠὰ <num value="20">κ</num> καὶ λάχανα. ποίησον τὴν ἄκανθαν κα

    <lb n="4" break="no"/>ταβληθῆναι καὶ τὴν ὕλην αὐτῆς βάλε εἰς τ<unclear>ὸν</unclear> 

    <lb n="5"/><app type="editorial"><lem resp="B.C. Jones, APF 58 (2012) 269-272"><subst><add place="inline"><choice><reg>τρύπανον</reg><orig><unclear>τρυπ</unclear>ινον</orig></choice></add><del rend="corrected">τρ<gap reason="illegible" quantity="2" unit="character"/>ινον</del></subst></lem><rdg resp="BL 1, 467">γρυτινὸν</rdg><rdg><subst><add place="inline"><unclear>τρυσ</unclear>ινον</add><del rend="corrected">τρ<gap reason="illegible" quantity="2" unit="character"/>ινον</del></subst></rdg></app>. ἀλλὰ σὺ κατάβαλε καὶ καῦσον τὴν ῥί

    <lb n="6" break="no"/>ζαν αὐτῆς, καὶ ἐὰν συντελεσθῇ τὸ ἔργον μέχρι 

    <lb n="7"/>τοῦ χώματος, καταβληθήτω ἡ κ<gap reason="illegible" quantity="2" unit="character"/><unclear>νις</unclear> καὶ <hi rend="diaeresis">ἰ</hi>σω

    <lb n="8" break="no"/>θήτω τὸ πὰν τοῦ κεχωσμένου. καὶ θὲς τὴν ὀπτὴν 

    <lb n="9"/>πλίνθον π<supplied reason="lost">α</supplied>ρὰ τὴν πλάτην, καὶ ἔρχεται ὁ οἰκοδό

    <lb n="10" break="no"/>μος <unclear>καὶ</unclear> οἰκοδομεῖ τὴν νοτινὴν πλάτην. <supplied reason="lost">καὶ</supplied> 

    <lb n="11"/>εἶπον τῷ φροντιστῇ Ἀπολλωνίου περὶ τῆς <unclear>μ</unclear>η

    <lb n="12" break="no"/><supplied reason="lost">χανῆς</supplied> <unclear>ἣ</unclear>ν ἔλεγέν μοι ὅτι ἐὰν γένωμαι ἐκεῖ 

    <lb n="13"/><gap reason="lost" quantity="15" unit="character"/><supplied reason="lost"> τοῖς</supplied> τέκτοσι κα<unclear>ὶ</unclear> <gap reason="illegible" quantity="4" unit="character"/> 


    <lb n="14"/><gap reason="lost" quantity="18" unit="character"/><unclear>τέ</unclear>τωσαν οἱ <choice><reg>ποταμῖ

    <lb n="15" break="no"/><supplied reason="lost">ται</supplied></reg><orig>ποταμεῖ<lb n="15" break="no"/><supplied reason="lost">ται</supplied></orig></choice><gap reason="lost" quantity="16" unit="character"/>ν παύσηται καὶ μὴ 

    <lb n="16"/><gap reason="lost" quantity="27" unit="character"/><gap reason="illegible" quantity="3" unit="character"/><unclear>α</unclear> <add place="above">χωρίον</add> 

    <lb n="17"/><gap reason="lost" extent="unknown" unit="line"/> 
</ab></div><div n="ms" type="textpart" xml:id="_ms"><head>ms</head><ab>

    <lb n="17"/><handShift new="m2"/> <supplied reason="lost">ποί</supplied>ησον ἀπὸ τῆς ἁλωνείας γενέσθαι τοῖς πο<supplied reason="lost">ταμίταις</supplied> 

    <lb n="18"/><supplied reason="lost">ἐκ Σ</supplied>τρατονίκου εἰς Μοῦχ<supplied reason="lost">ι</supplied>ν <expan><ex>ἀρτάβας</ex></expan> <num value="8">η</num> <num value="1/2">𐅵</num> <choice><reg>σίτου</reg><orig>σ<unclear>εί</unclear>του</orig></choice> <gap reason="illegible" quantity="1" unit="character"/><gap reason="lost" quantity="8" unit="character"/> 

    <lb n="19"/><gap reason="lost" quantity="3" unit="character"/>δω γενο<unclear>ῦ</unclear> μ<unclear>ετ</unclear>ʼ <unclear>α</unclear><supplied reason="lost">ὐ</supplied>το<unclear>ῦ</unclear> ἐκε<supplied reason="lost">ῖ </supplied><gap reason="lost" extent="unknown" unit="character"/> </ab></div></div></body>
