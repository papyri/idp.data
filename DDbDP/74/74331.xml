      <body><head><ref target="https://papyri.info/editions/o.edfou/2/321" n="91542"><title>O.Edfou 2 321</title><date>1938</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/><g type="stauros"/> 

    <lb n="2"/>ἐδόθη <expan>δ<ex>ιὰ</ex></expan> Ἰσ<unclear>α</unclear>κ<supplied reason="lost">ίου <expan>υ<ex>ἱοῦ</ex></expan></supplied> <unclear>Ἰακώ</unclear><supplied reason="lost">βου</supplied> 

    <lb n="3"/>Βᾶσαρ ἀπὸ <expan>δημοσί<ex>ου</ex></expan> ἑνδεκάτης <expan>ἰνδ<ex>ικτίονος</ex></expan> χρυσοῦ νόμισ

    <lb n="4" break="no"/>μα ἓν κεράτια ὀκτὼ ἥμισυ 

    <lb n="5"/>τέταρτον, <expan>γί<ex>νεται</ex></expan> <expan>ν<ex>όμισμα</ex></expan> <num value="1">α</num> <expan><ex>κεράτια</ex></expan> <num value="8">η</num> <num value="1/2">𐅵</num> <num value="1/4" rend="tick">δ</num> <g rend="extension" type="filler"/> 

    <lb n="6"/>καὶ ταῦτα λογίζονται αὐτὰ <supplied reason="omitted" cert="low">ἐκφορίου</supplied> λόγου <expan>γινόμε<ex>να</ex></expan>. 

    <lb n="7"/><expan>Φλ<ex>άουιος</ex></expan> Ἱερακίων <expan>υἱ<ex>ὸς</ex></expan> Παρα<gap reason="illegible" quantity="4" unit="character"/> <expan><ex>καὶ</ex></expan> <expan>Ἰωάν<ex>νης</ex></expan> στοιχεῖ <expan><unclear>ἡ</unclear><ex>μῖν</ex></expan> <g type="stauros"/> </ab></div></body>
