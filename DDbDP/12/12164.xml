         <head>
            <ref n="11749" target="https://papyri.info/editions/p.mich/5/353">
               <title>P.Mich. 5 353</title>
               <date>1944</date>
            </ref>
         </head>
         <div xml:lang="grc" type="edition" xml:space="preserve"><div n="r" type="textpart" xml:id="_r"><head>r</head><ab>

    <lb n="1"/>Ἡρακλείδης <app type="editorial"><lem resp="BL 8.213"/><rdg><supplied reason="lost">Ἡρακλείδου</supplied></rdg></app> 

    <lb n="2"/>Κρονίωνι Ἀπίωνος νομογράφωι 

    <lb n="3"/>Τεβτύνεως χαίρειν. ὁμολογῶ 

    <lb n="4"/>ἀπερίσπαστον καὶ <choice><reg>ἀνείσπρακτόν</reg><orig>ἀνίσπρακτόν</orig></choice> 

    <lb n="5"/>σε ποιήσειν καὶ τοὺς παρὰ σοῦ 

    <lb n="6"/>κατὰ πάντα τρόπον ὑπὲρ ἧς 

    <lb n="7"/>ἔσχον παρὰ σοῦ τὴν <choice><reg><unclear>προ</unclear>γε

    <lb n="8" break="no"/>γονυίαν</reg><orig>προγε<lb n="8" break="no"/>γονυίην</orig></choice> διὰ σοῦ <choice><reg>εἰς</reg><orig>ἰς</orig></choice> τὸν πατέρα 

    <lb n="9"/>μου Ἡρακλείδην νεώτερον 

    <lb n="10"/>Μάρωνος <choice><reg>ὃς</reg><orig>ὣς</orig></choice> τετελεύτηκεν 

    <lb n="11"/>ἔτι πάλαι παραχώρησιν 

    <lb n="12"/>ἀρουρῶν <app type="editorial"><lem resp="BL 6.82"><num value="13">δε<supplied reason="omitted">κα</supplied>τριῶν</num></lem><rdg><surplus>δὲ</surplus> <num value="3">τριῶν</num></rdg></app> <num value="1/2">ἡμίσους</num> 

    <lb n="13"/>Ἡρώδου τοῦ καὶ Ἡρακλείδου 

    <lb n="14"/>Λυσιμάχου διὰ τὸ μὴ ἀνα

    <lb n="15" break="no"/>δεδωκ<unclear>έναι</unclear> <unclear>σοι</unclear> <unclear>α</unclear><supplied reason="lost">ὐ</supplied><unclear>τὸν</unclear> <unclear>τ</unclear><supplied reason="lost">ὸ</supplied><unclear>ν</unclear> 

    <lb n="16"/><choice><reg>πατέρα</reg><orig>πατέραν</orig></choice> μου ἐπίσταλμα 

    <lb n="17"/>τῶν προόντων <choice><reg>κ<supplied reason="lost">α</supplied>ταλο

    <lb n="18" break="no"/>χισμῶν</reg><orig>κ<supplied reason="lost">α</supplied>ταλο<lb n="18" break="no"/>χιζμῶν</orig></choice> <choice><reg>ἐκείνου</reg><orig>ἐκίνου</orig></choice> τοῦ ἔτους 

    <lb n="19"/>διὰ τὸ <app type="editorial"><lem resp="PN B. Borrelli (from image)">πα<unclear>ρ</unclear>εκπέπτω<lb n="20" break="no"/>κέναι</lem><rdg>πᾶ<unclear>ν</unclear> ἐκπεπτω

    <lb n="20" break="no"/>κέναι</rdg></app> τὸ <unclear>αὐτὸ</unclear> ἐπίσταλμα, 

    <lb n="21"/>τὸν δὲ ἐνκαλέσαντα οὖν <supplied reason="omitted" cert="low">κωλύσειν</supplied> 

    <lb n="22"/><unclear>πε</unclear>ρὶ τούτου ἢ περὶ ἄλλου 

    <lb n="23"/>τινὸς τ<unclear>ῶν</unclear> <choice><reg><expan>δεδηλωμένω<ex>ν</ex></expan></reg><orig><expan><unclear>δεδηλ</unclear>ουμένω<ex>ν</ex></expan></orig></choice> 

    <lb n="24"/>τῇ αὐτῇ <choice><reg>παραχωρήσει</reg><orig>παραχωρήσι</orig></choice>. ἡ χεὶρ 

    <lb n="25"/><choice><reg>ἥδε</reg><orig>ἥδηι</orig></choice> κυρία <choice><reg>ἔστω</reg><orig>ἔστων</orig></choice> παν

    <lb n="26" break="no"/>ταχῇ <choice><reg>ἐπιφερομένη</reg><orig>ἐπιφερόμενον</orig></choice> καὶ παν

    <lb n="27" break="no"/>τὶ τῷ ἐπιφέροντι. <expan><ex>ἔτους</ex></expan> <choice><reg>ὀγδόου</reg><orig>ὀγδώου</orig></choice> 

    <lb n="28"/>Τιβερίου Κλαυδίου Καίσαρος 

    <lb n="29"/><supplied reason="lost">Σεβαστοῦ</supplied> Γερμανικοῦ 

    <lb n="30"/><supplied reason="lost">Αὐτο</supplied><unclear>κρά</unclear><supplied reason="lost">τορος Φ</supplied>αρμοῦθι <num value="14">ιδ</num>. 
</ab></div><div n="v" type="textpart" xml:id="_v"><head>v</head><ab>

    <lb n="1"/>αδ<gap reason="illegible" quantity="2" unit="character"/>υφ<unclear>ω</unclear> </ab></div></div>
