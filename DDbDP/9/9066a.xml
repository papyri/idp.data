    <lb n="4"/>εἰκοστοῦ ἔτους δραχμὰς δέκα ἓξ <num value="1"><expan><ex>ὀβολὸν</ex></expan></num> <num value="1/2"><expan><ex>ἡμιωβέλιον</ex></expan></num> <expan><ex>γίνονται</ex></expan> <expan><ex>δραχμαὶ</ex></expan> <num value="16">ιϛ</num> <num value="1"><expan><ex>ὀβολὸς</ex></expan></num> <num value="1/2"><expan><ex>ἡμιωβέλιον</ex></expan></num> <app type="editorial"><lem><expan>προ<ex>σδιαγραφόμενα</ex></expan></lem><rdg><abbr>προ</abbr></rdg></app> <expan><ex>δραχμὴ</ex></expan> <num value="1">α</num> <num value="2"><expan><ex>δίχαλκον</ex></expan></num> 

    <lb n="5"/>καὶ εἰς Πεθέα Ἁτρείους ὁμοίως <app type="editorial"><lem resp="BL 1.40"><expan>ἀριθ<ex>μητικοῦ</ex></expan> <expan><supplied reason="lost">κ<ex>ατ</ex></supplied>οί<ex>κων</ex></expan></lem><rdg><expan>ἀριθ<ex>μήσεως</ex></expan> <expan><supplied reason="lost">κ</supplied>οι<ex>νῆσ</ex></expan></rdg></app> <expan><ex>δραχμὰς</ex></expan> πέντε <num value="2"><expan><ex>διώβολον</ex></expan></num> <num value="1/2"><expan><ex>ἡμιωβέλιον</ex></expan></num> 

