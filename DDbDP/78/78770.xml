      <body><head><ref target="https://papyri.info/editions/p.tebt/1/36" n="95981"><title>P.Tebt. 1 36</title><date>1902</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><div n="r" type="textpart" xml:id="_r"><head>r</head><ab>

    <lb n="1"/>Ἀπολλώ<supplied reason="lost">ν</supplied>ιος Κρίτωνι <gap reason="lost" quantity="12" unit="character"/> 

    <lb n="2"/>πολλὰ χαίρει<supplied reason="lost">ν</supplied> καὶ ἐρρῶ<supplied reason="lost">σθαι.  γίνωσκε</supplied> 

    <lb n="3"/><choice><reg>ἐκπεπλη<supplied reason="omitted">ρω</supplied>κέναι</reg><orig>ἐκπεπληκέναι</orig></choice> ἡμᾶς τὴν κ<gap reason="lost" quantity="15" unit="character"/> 

    <lb n="4"/>μὴ προσδεχομένου ὑπὲρ τῶ<supplied reason="lost">ν </supplied><gap reason="lost" quantity="15" unit="character"/> 

    <lb n="5"/>τριάκοντα <num value="30"/> ἀρτάβας ἀλλὰ ἐκπ<gap reason="lost" quantity="15" unit="character"/> 

    <lb n="6"/>πεπληρώκαμεν τὰς <num value="48">μη</num> <num value="1/2">𐅵</num> <expan><ex>ἀρτάβας</ex></expan>, π<supplied reason="lost">ε</supplied><unclear>ρὶ</unclear> <supplied reason="lost">δὲ</supplied> <unclear>τ</unclear><supplied reason="lost">ῶν τὴν</supplied> 

    <lb n="7"/>ἱερὰν ἐχόντων ἐν ὑπολόγωι τῶι μεε<unclear>ι</unclear><gap reason="lost" quantity="7" unit="character"/> 

    <lb n="8"/>βασιλεῖ μετροῦσι πέπεικʼ αὐτοὺς ἐφʼ ὧι τ<gap reason="illegible" quantity="1" unit="character"/><gap reason="lost" quantity="5" unit="character"/> 

    <lb n="9"/>τοῦ <app type="editorial"><lem resp="BL 3.240"><expan><ex>ἡμιαρταβίου</ex></expan></lem><rdg><expan><ex>ἡμίσους</ex></expan> <expan><ex>ἀρτάβης</ex></expan></rdg></app> καὶ τῆς εἰσφορᾶς <unclear>ἵ</unclear>να ταῦτα εἰς τὴν <app type="editorial"><lem resp="BL 7.269"><gap reason="lost" quantity="6" unit="character"/>

    <lb n="10" break="no"/>κα εἰς Κοστῆν</lem><rdg><supplied reason="lost">τετρα</supplied><lb n="10" break="no"/>κα<supplied reason="omitted">ι</supplied>ει<surplus>σ</surplus>κοστὴν</rdg></app> παραμετρήσωμεν <supplied reason="lost">. </supplied><gap reason="lost" quantity="3" unit="character"/><gap reason="illegible" quantity="1" unit="character"/><gap reason="lost" quantity="7" unit="character"/> 

    <lb n="11"/>περὶ δὲ τῶν γεωργῶν <choice><reg>πεπείκασι</reg><orig>πεπ<unclear>ε</unclear><supplied reason="lost">ι</supplied>καν</orig></choice> <unclear>τ</unclear>ὰ περ<unclear>ὶ</unclear> <gap reason="lost" quantity="4" unit="character"/> 

    <lb n="12"/><gap reason="lost" extent="unknown" unit="line"/> 
</ab></div><div n="v" type="textpart" xml:id="_v"><head>v</head><ab>

    <lb n="1"/>Κρίτ<supplied reason="lost">ω</supplied>νι. </ab></div></div></body>
