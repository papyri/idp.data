      <body><head><ref target="https://papyri.info/editions/bgu/1/47" n="37744"><title>BGU 1 47</title><date>1895</date></ref>; <ref target="https://papyri.info/editions/stud.pal/3/265" n="64387"><title>Stud.Pal. 3 265</title><date>1904</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
