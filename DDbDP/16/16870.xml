         <div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/><supplied reason="lost">ἐπὶ ὑπάτων τῶν κυρίων ἡμῶν αὐτοκρατόρων Κω</supplied><unclear>ν</unclear><supplied reason="lost">σ</supplied><unclear>ταν</unclear><supplied reason="lost">τίου</supplied> <unclear>τὸ</unclear> <gap reason="illegible" quantity="1" unit="character"/> καὶ <app type="editorial"><lem resp="PN N. Gonis (from image)">Μαξιμιανοῦ

    <lb n="2"/><supplied reason="lost">τὸ </supplied><gap reason="lost" quantity="1" unit="character"/> <supplied reason="lost">Σ</supplied>εβασ<unclear>τ</unclear><supplied reason="lost">ῶν·</supplied></lem><rdg><supplied reason="lost">Μαξιμιανοῦ τὸ </supplied><gap reason="lost" quantity="1" unit="character"/> <supplied reason="lost">Σ</supplied>εβασ<unclear>τ</unclear><supplied reason="lost">ῶν·</supplied></rdg></app> 

    <lb n="3"/><supplied reason="lost">Αὐρηλίοις Ἱερακ</supplied><unclear>ί</unclear>ωνι τ<unclear>ῷ</unclear> <supplied reason="lost">κ</supplied><unclear>αὶ</unclear> <unclear>Δ</unclear><supplied reason="lost">ιονυσ</supplied><unclear>ί</unclear><supplied reason="lost">ῳ</supplied> γυμ<unclear>ν</unclear><supplied reason="lost">α</supplied><unclear>σιά</unclear><supplied reason="lost">ρ</supplied>χῳ βουλευτῇ 

    <lb n="4"/><app type="editorial"><lem resp="L.Ε. Tacoma, Fragile Hierarchies 301"><supplied reason="lost">πρυτανεύσαντι ἐνάρχῳ</supplied> <choice><reg><supplied reason="lost">πρ</supplied>υτάνει</reg><orig><supplied reason="lost">πρ</supplied><unclear>υ</unclear>τάνι</orig></choice></lem><rdg><gap reason="lost" quantity="20" unit="character"/><supplied reason="lost"> πρ</supplied><unclear>υ</unclear>τάνι</rdg></app> τῆς λαμπρᾶς καὶ λαμπροτάτης 

    <lb n="5"/><supplied reason="lost">Ὀξυρυγχιτῶν πόλεως καὶ</supplied> <app type="editorial"><lem><gap reason="lost" quantity="3" unit="character"/><unclear>μ</unclear>ῳ</lem><rdg resp="BL 12.146"><supplied reason="lost">Διδύ</supplied><unclear>μ</unclear>ῳ</rdg></app> γυμ<unclear>να</unclear>σιάρχῳ καὶ Σαραπίωνι 

    <lb n="6"/><gap reason="lost" quantity="29" unit="character"/><supplied reason="lost"> σ</supplied><unclear>υ</unclear>ν<supplied reason="lost">δ</supplied><unclear>ί</unclear>κοις τῆς αὐτῆς πόλεως 

    <lb n="7"/><app type="editorial"><lem resp="BL 6.111"><supplied reason="lost">Αὐρήλιοι Μωρ</supplied><unclear>ί</unclear><supplied reason="lost">ω</supplied>ν</lem><rdg><supplied reason="lost">Αὐρήλιοι </supplied><gap reason="lost" quantity="2" unit="character"/><gap reason="illegible" quantity="1" unit="character"/><gap reason="lost" quantity="1" unit="character"/>ν</rdg></app> ὁ καὶ <choice><reg>Ἡρακλειανὸς</reg><orig>Ἡρακλιανὸς</orig></choice> ἀρχιερατεύ<unclear>σ</unclear><supplied reason="lost">ας</supplied> καὶ <supplied reason="lost">Ἀ</supplied>γαθῖνος 

    <lb n="8"/>ἐξηγητὴς ἀμφότεροι βουλευταὶ τῆς αὐτῆς πόλεως βιβλι

    <lb n="9" break="no"/>οφύλακες τοῦ αὐτοῦ νομοῦ τ<supplied reason="lost">ο</supplied><unclear>ῖ</unclear><supplied reason="lost">ς</supplied> <unclear>φ</unclear><supplied reason="lost">ιλτάτο</supplied><unclear>ι</unclear><supplied reason="lost">ς</supplied> χαίρειν. 

    <lb n="10"/><choice><reg>ἐπεστεί<supplied reason="lost">λατε</supplied></reg><orig>ἐπεστ<unclear>ί</unclear><supplied reason="lost">λατε</supplied></orig></choice> <supplied reason="lost">ἡμῖν κ</supplied>εκελευκέναι Αὐρήλιον Ἀθανάσιον ἐπίτροπον 

    <lb n="11"/>τῆς κατʼ Αἴγυπτον πριουάτης διʼ ὧν ἔγραψεν κατὰ θεῖον πρόσταγ<g type="apostrophe"/>μα 

    <lb n="12"/>τῶν δεσποτῶν ἡμῶν βασιλέων τε καὶ Κα<add place="above">ι</add>σάρων ἀκολούθως 

    <lb n="13"/>τοῖς <choice><reg>ἐπιτεθεῖσι</reg><orig>ἐπιτετῖσι</orig></choice> πρὸς αὐτὸν γράμμασι Νερατίου Ἀπολλωνίδου τὰ <hi rend="diaeresis">ὑ</hi>

    <lb n="14" break="no"/>πάρχοντα Παύλου ἀπὸ τοῦ Ὀξυρυγχίτου <choice><reg>ἀποφάσει</reg><orig>ἀποφάσι</orig></choice> ὑποβληθέντος 

    <lb n="15"/>τοῦ διασημοτάτου ἡγουμένου <unclear>Θη</unclear>βα<hi rend="diaeresis">ί</hi>δος Σατρίου <choice><reg>Ἀρριανοῦ</reg><orig>Ἀριανοῦ</orig></choice> <choice><reg>προσκριθῆναι</reg><orig>προσκρειθῆναι</orig></choice> 

    <lb n="16"/>τοῖς τοῦ <choice><reg>ταμείου</reg><orig>ταμίου</orig></choice> λογισμοῖς καὶ <choice><reg>ἐγγρ<supplied reason="lost">ά</supplied>φως</reg><orig>ἐνγρ<supplied reason="lost">ά</supplied>φως</orig></choice> ἐπιδοῦναι. ὅθεν ἐξετάσαντες 

    <lb n="17"/>διὰ τῶν <choice><reg>κατακειμένων</reg><orig>κατακιμένων</orig></choice> ἐν τοῖς <choice><reg>βιβλιοφυλακείοις</reg><orig>βιβλιοφυλακίοις</orig></choice> βιβ<unclear>λ</unclear><supplied reason="lost">ί</supplied>ων 

    <lb n="18"/>δηλοῦμεν τὸν Παῦλον μηδὲν κεκτῆσθαι μηδʼ <unclear>ὅλω</unclear>ς διεστρῶσθαι διὰ <expan>τῶ<ex>ν</ex></expan> 

    <lb n="19"/><choice><reg>κατακειμένων</reg><orig>κατακιμένων</orig></choice> ἐν τοῖ<supplied reason="lost">ς</supplied> <choice><reg>βιβλιοφυλακείοις</reg><orig>βιβλιοφυλακίοις</orig></choice> βιβ<unclear>λ</unclear><supplied reason="lost">ίω</supplied><unclear>ν</unclear> μηδὲ <add place="above">ε</add>ἰδέναι τὴν τού

    <lb n="20" break="no"/>του <choice><reg>γυναῖκα</reg><orig>γυνε͂κα</orig></choice> τινα <gap reason="lost" quantity="3" unit="character"/> τω μὴ <unclear>φαίν</unclear>εσθαι τὸν <choice><reg><supplied reason="lost">π</supplied>ρ<supplied reason="lost">ο</supplied>κείμενον</reg><orig><supplied reason="lost">π</supplied><unclear>ρ</unclear><supplied reason="lost">ο</supplied><unclear>κίμενον</unclear></orig></choice> Παῦλον 

    <lb n="21"/>διεστρωμ<unclear>έ</unclear><supplied reason="lost">νον διὰ</supplied> <unclear>τ</unclear><supplied reason="lost">ῶ</supplied><unclear>ν</unclear> <unclear>αὐ</unclear>τῶν <choice><reg>κατακειμένων</reg><orig>κατακιμένων</orig></choice> <supplied reason="lost">ἐ</supplied>ν τοῖς δημ<supplied reason="lost">ο</supplied>σίοις <choice><reg>ἀρχείοις</reg><orig>ἀρχίοις</orig></choice> 

    <lb n="22"/><supplied reason="lost">βιβλίων </supplied><gap reason="lost" extent="unknown" unit="character"/> 

    <lb n="23"/><handShift new="m2"/> <unclear>ἐρρ</unclear>ῶσθαι ὑμ<unclear>ᾶς</unclear> εὔχομ<unclear>αι</unclear>, <expan>φίλ<ex>τατοι</ex></expan> 

    <lb n="24"/><handShift new="m1" cert="low"/> <expan><ex>ἔτους</ex></expan> <gap reason="lost" quantity="2" unit="character"/><supplied reason="lost"> καὶ </supplied><gap reason="lost" quantity="1" unit="character"/><gap reason="illegible" quantity="2" unit="character"/> τῶν κυρίων ἡμῶν Κωνσ<unclear>τ</unclear><supplied reason="lost">α</supplied><unclear>ν</unclear>τίου καὶ Μαξιμιανοῦ 

    <lb n="25"/>Σεβαστῶν <gap reason="lost" quantity="25" unit="character"/><gap reason="illegible" quantity="1" unit="character"/> Μαξιμίνου τῶν ἐπιφανεστάτων 

    <lb n="26"/>Καισάρων <gap reason="lost" extent="unknown" unit="character"/> </ab></div>
