      <body><head><ref target="https://papyri.info/editions/o.wilck/1512" n="42521"><title>O.Wilck. 2 1512</title><date>1899</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/>ἔτους <num value="28">κη</num> Ἐπεὶφ <num value="26">κϛ</num> <expan>με<ex>μέτρηκεν</ex></expan> 

    <lb n="2"/>εἰς τὸν <expan>στέφα<ex>νον</ex></expan> <expan>κα<ex>τοίκων</ex></expan> Ἁρμᾶις <expan>Πανίσκ<ex>ου</ex></expan> 

    <lb n="3"/>καὶ οἱ <expan>ἀδελ<ex>φοὶ</ex></expan> <expan><ex>πυροῦ</ex></expan> <expan><ex>ἀρτάβας</ex></expan> πέντε ἥμισυ τρίτον 

    <lb n="4"/><expan>δωδέκα<ex>τον</ex></expan> <expan><ex>γίνονται</ex></expan> <num value="5">ε</num> <num value="1/2">𐅵</num> <num value="1/3" rend="tick">γ</num> <num value="1/12" rend="tick">ιβ</num>, <expan>Μεσο<ex>ρὴ</ex></expan> <num value="16">ιϛ</num> πέντε ἥμισυ <num value="5"/><num value="1/2"/>, 

    <lb n="5"/><num value="29">κθ</num> <expan><ex>ἔτους</ex></expan> <expan>Θῶ<ex>υθ</ex></expan> <num value="24">κδ</num> δύο ἥμισυ <expan>τρίτο<ex>ν</ex></expan> <num value="2"/><num value="1/2"/><num value="1/3"/>, <expan>Φαῶ<ex>φι</ex></expan> <num value="24">κδ</num> 

    <lb n="6"/>δύο τρίτον <num value="2"/><num value="1/3"/>, <expan>ἐπαγομ<ex>ενῶν</ex></expan> <num value="1">α</num> <num value="1/2">𐅵</num> <num value="1/3" rend="tick">γ</num> <num value="1/12" rend="tick">ιβ</num> 

    <lb n="7"/><expan><ex>γίνονται</ex></expan> <num value="19">ιθ</num> <num value="1/2">𐅵</num> <num value="1/3" rend="tick">γ</num> <num value="1/12" rend="tick">ιβ</num>. </ab></div></body>
