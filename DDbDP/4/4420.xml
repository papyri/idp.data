    <lb n="2"/>εἰς τὸ <num value="27">κζ</num> <supplied reason="omitted">τὸ</supplied> καὶ <num value="24">κδ</num> <expan><ex>ἔτος</ex></expan> Ἀρτεφναχόει <expan>χαί<ex>ρειν</ex></expan>. ἀπέχω παρά σου τὴν <num value="2">β</num> <num value="1/2">𐅵</num> <expan>χα<ex>λκοῦ</ex></expan> <num value="500">φ</num> <expan><ex>γίνονται</ex></expan> <num value="500">φ</num> 

