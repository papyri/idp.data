      <body><head><ref target="https://papyri.info/editions/bgu/2/616" n="26939"><title>BGU 2 616</title><date>1898</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/>ἐωνησάμην 

    <lb n="2"/><expan>π<ex cert="low">ερὶ</ex></expan> ὑπάρχουσί μοι <del rend="erasure"><expan><ex>ἀρουρ  </ex></expan></del> περὶ κώμην <expan>Καρ<ex>ανίδα</ex></expan> 

    <lb n="3"/>κλήρου <expan><supplied reason="lost">κα</supplied>τοικ<ex>ικοῦ</ex></expan> <expan><ex>ἀρούρης</ex></expan> <num value="1/2">𐅵</num> ἐν <app type="editorial"><lem resp="BL 1.57"><unclear>τ</unclear>όπῳ</lem><rdg><expan>ἐπο<supplied reason="lost">ικ<ex>ίῳ</ex></supplied></expan></rdg></app> <expan>Κο<supplied reason="lost">ι</supplied>λ<ex>άδι</ex></expan> <expan>λεγο<ex>μένῳ</ex></expan>. 

    <lb n="4"/><choice><reg>ἐπεὶ</reg><orig>ἐπὶ</orig></choice> οὖν παρορίζομαι <supplied reason="lost">ὑ</supplied><unclear>π</unclear>ὸ τῶν <choice><reg>γειτόνων</reg><orig>γιτόνων</orig></choice>, 

    <lb n="5"/>ἀξιῶ <unclear>ἐ</unclear><supplied reason="lost">π</supplied><unclear>ι</unclear>τα<supplied reason="lost">γ</supplied>ῆναι <supplied reason="lost">τῷ τ</supplied>ῆ<supplied reason="lost">ς</supplied> κώμης <expan>κωμογρ<ex>αμματεῖ</ex></expan> 

    <lb n="6"/>γενέσθα<supplied reason="lost">ι</supplied> ἐπὶ τοὺ<supplied reason="lost">ς</supplied> τόπους σὺν τῷ <choice><reg><expan>ὁριοδείκ<ex>τῃ</ex></expan></reg><orig><expan>ὁριοδίκ<ex>τῃ</ex></expan></orig></choice> 

    <lb n="7"/>καὶ ἀναμετρῆσαι <supplied reason="lost">τ</supplied>ὴν <choice><reg>πᾶσαν</reg><orig>πᾶσα</orig></choice> γ<unclear>ῆ</unclear>ν καὶ ἑκάστῳ 

    <lb n="8"/>τὸ ἴδιο<supplied reason="lost">ν</supplied> <choice><reg>ἀποκαταστῆσαι</reg><orig>ἀπ<supplied reason="lost">ο</supplied>καταστῆση</orig></choice> </ab></div></body>
