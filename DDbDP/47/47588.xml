<ab>
    <lb n="1"/>Πλέωμρις Ὥρου καὶ

    <lb n="2"/><surplus>καὶ</surplus> Κολλούθης <expan>Νεφέρωτο<ex>ς</ex></expan>

    <lb n="3"/>οἱ ἐξειληφότες τὸ τέλος

    <lb n="4"/><subst><add place="inline">τῆς</add><del rend="corrected">το</del></subst> κεδρίας καὶ τοῦ <expan>φαρμάκ<unclear>ο</unclear><ex>υ</ex></expan>

    <lb n="5"/>τοῦ Κυνοπολίτου

    <lb n="6"/>Ἁρβίχει χαίρειν. ἀπέχο

    <lb n="7" break="no"/>μεν παρὰ σοῦ τὸ τέλος

    <lb n="8"/>τοῦ <subst><add place="inline">φαρ<add place="above">μά</add>κου</add><del rend="corrected">φαρκα<certainty match=".." locus="value"/></del></subst> καὶ τῆς κε

    <lb n="9" break="no"/>δρίας τῆς γυναικός

    <lb n="10"/>σου Τνεφορσόιτος διὰ

    <lb n="11"/>νεκροτάφου Ἁρεντώθου

    <lb n="12"/>τοῦ <choice><reg>Ἁρπαπάσιτος</reg><orig>Ἁρπαπάσ<unclear>ε</unclear>ιτος</orig></choice>

    <lb n="13"/>κουθέν σοι ἐγκαλοῦμεν.
<milestone rend="paragraphos" unit="undefined"/>
