      <body><head><ref target="https://papyri.info/editions/p.lips/1/75" n="21346"><title>P.Lips.  1 75</title><date>1906</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve">
<ab>
    <lb n="1"/><expan>μέ<ex>τρημα</ex></expan> <expan>θησ<ex>αυροῦ</ex></expan> <expan>μη<ex>τροπόλεως</ex></expan> <expan>γ<ex>εν</ex>ή<ex>ματος</ex></expan> <num value="5">ε</num> <expan><ex>ἔτους</ex></expan> <expan>Ἀντων<ex>είνου</ex></expan> 

