         <head>
            <ref target="https://papyri.info/editions/o.crum/331" n="102333">
               <title>O.Crum 331</title>
               <date>1902</date>
            </ref>
         </head>
         <div type="commentary" subtype="frontmatter" xml:space="preserve"><p>Where diacritical signs or supralinear strokes above letters are present on the original, these were not recorded in Crum's edition. Since Crum in his later editions did indicate these marks, we have chosen to add them tacitly where access to an image has made this possible.</p></div>
         <div xml:lang="cop" type="edition" xml:space="preserve">         
<ab>
<lb n="1"/>ⲕⲥⲟⲟⲩⲛ ϫⲉ ⲧⲛⲥⲣⲟϥⲧ ⲁⲛ ⲧⲉ

<lb n="2" break="no"/>ⲛⲟⲩ ϣⲓⲛⲉ <choice><reg xml:lang="grc">ἀκριβῶς</reg><orig>ⲁⲕⲣⲓⲃⲱⲥ</orig></choice> ⲉⲕϭⲛⲧϥ 

<lb n="3"/>ⲉⲕϫⲟⲟⲩ ⲛⲁⲓ ⲛⲧⲁϫⲟⲟⲩ ⲛⲧⲁ

<lb n="4" break="no"/>ϥⲓⲧ<hi rend="supraline">ϥ</hi> ⲁ<hi rend="diaeresis">ⲓ</hi>ϫⲟⲟⲩ ⲁⲛⲇⲣⲉⲁⲥ ⲛ

<lb n="5" break="no"/>ⲥⲁϥ ⲟⲛ ϫⲉ ϣⲓⲛⲉ ⲉⲧⲃⲉ ⲡⲉⲓϩⲱⲃ 

<lb n="6"/>ⲟⲩϫⲁⲓ ⲧⲁⲁⲥ ⲙⲡ<choice><reg xml:lang="grc">πρεσβύτερος</reg><orig><expan>ⲡⲣⲉⲥⲃ<ex>ⲩⲧⲉⲣⲟⲥ</ex></expan></orig></choice> <gap reason="illegible" extent="unknown" unit="character"/>

<lb n="7"/>ⲁⲡⲁ ⲓⲱϩⲁⲛⲛⲏⲥ ϩⲓⲧⲙ ⲡⲉⲥⲓⲛ

<lb n="8" break="no"/>ⲧⲉ ⲡⲓ<choice><reg xml:lang="grc">ἐλάχιστος</reg><orig><expan>ⲉⲗⲁⲭ<ex>ⲓⲥⲧⲟⲥ</ex></expan></orig></choice>
</ab>
