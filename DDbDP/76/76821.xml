      <body><head><ref target="https://papyri.info/editions/o.wilck/254" n="94032"><title>O.Wilck. 2 254</title><date>1899</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/>Οὐαλέριος Σερῆνος καὶ Πα<supplied reason="lost">τ</supplied>εχῆμις οἱ <num value="2">β</num> 

    <lb n="2"/><expan>πρά<ex>κτορες</ex></expan> <expan>ἀργ<ex>υρικῆς</ex></expan> <expan>Ἐ<ex>λε</ex>φαντ<ex>ίνης</ex></expan> διὰ <expan>Πετορζ<ex>μήθου</ex></expan> <expan>βοηθ<ex>οῦ</ex></expan>. <expan>διέγρ<ex>αψεν</ex></expan> 

    <lb n="3"/>Παναπῶτις Παπρεμίθου <expan>μητ<ex>ρὸς</ex></expan> Θι<supplied reason="lost">ν</supplied>

    <lb n="4" break="no"/>πετεπουῆρις <expan>ὑπ<ex>ὲρ</ex></expan> <expan>μερισ<ex>μῶν</ex></expan> <num value="2">β</num> <expan><ex>ἔτους</ex></expan> <expan>ἀνδριάντ<ex>ων</ex></expan> καὶ <expan>π<supplied reason="lost">ρο</supplied>τομ<ex>ῶν</ex></expan> 

    <lb n="5"/>τῶν κυρίων Καισάρων κατὰ μέρ<supplied reason="lost">ος</supplied> <expan><ex>δραχμὰς</ex></expan> <num value="10">ι</num>. 

    <lb n="6"/><gap reason="illegible" quantity="4" unit="character"/><gap reason="illegible" quantity="2" unit="character"/> <expan><ex>ἔτους</ex></expan> <num value="3">γ</num> Ἀντωνίνου 

    <lb n="7"/>καὶ Οὐήρου Καισάρων τῶν κυρίων Π<supplied reason="lost">α</supplied>χὼν <gap reason="illegible" quantity="2" unit="character"/> 

    <lb n="8"/>τῇ αὐτῇ ἡμέρᾳ ὁ αὐτὸς <supplied reason="lost">ὁμο</supplied>ίως 

    <lb n="9"/><expan>ὑπ<ex>ὲρ</ex></expan> <choice><reg>τιμῆς</reg><orig>τειμῆς</orig></choice> <expan>δη<ex>μοσίου</ex></expan> <expan>φοί<ex>νικος</ex></expan> <expan>γενήματ<ex>ος</ex></expan> τοῦ αὐτοῦ <num value="2">β</num> <expan><ex>ἔτους</ex></expan> 

    <lb n="10"/><expan>ὀνόματ<ex>ος</ex></expan> Παχομπα<unclear>ουα</unclear>ρσήους Παοῦ

    <lb n="11" break="no"/>τος <expan><ex>δραχμὴν</ex></expan> <num value="1">α</num> <expan><ex>ὀβολοὺς</ex></expan> <num value="3">γ</num> <num value="1/2">𐅵</num>. </ab></div></body>
