      <body><head><ref target="https://papyri.info/editions/p.ross.georg/5/38" n="34856"><title>P.Ross.Georg. 5 38</title><date>1935</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/><g type="rho-cross"/> Ἰωάννης Ἀβρααμίου <space extent="unknown" unit="character"/> <gap reason="illegible" quantity="4" unit="character"/><gap reason="lost" quantity="9" unit="character"/> ἐδεξάμην παρά σου 

    <lb n="2"/>ὁμοῦ χρυσοῦ <expan>κεράτι<ex>α</ex></expan> εἴκοσι ἥμ<supplied reason="lost">ισ</supplied><unclear>υ</unclear> <expan>ζυ<ex>γῷ</ex></expan> <expan><unclear>γί</unclear><ex>νεται</ex></expan> <expan><unclear>κ</unclear><ex>εράτια</ex></expan> <num value="20">κ</num> <num value="1/2">𐅵</num> <expan>ζυ<ex>γῷ</ex></expan> καὶ τοῦτο 

    <lb n="3"/>ἑτοίμως ἔχω <choice><reg>λογίσασθαί</reg><orig>λογίζ<unclear>α</unclear>σθαί</orig></choice> σοι <gap reason="illegible" quantity="4" unit="character"/><gap reason="illegible" quantity="4" unit="character"/><gap reason="illegible" quantity="3" unit="character"/> βεβαιοῦντ<unclear>α</unclear>ς τῶν 

    <lb n="4"/>ἄλλων <expan><supplied reason="lost">ἐ</supplied>νταγί<ex>ων</ex></expan> τοῦ διαγράφου Φαμενὼθ <num value="10">ι</num> πρώτης <expan>ἰν<ex>δικτίονος</ex></expan>. 

    <lb n="5"/>Ἰωάννης ὁ <expan>προκ<ex>είμενος</ex></expan> <choice><reg>στοιχεῖ</reg><orig>στηχεῖ</orig></choice> μοι ὡς <expan>πρ<ex>όκειται</ex></expan>. </ab></div></body>
