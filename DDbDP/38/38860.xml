      <body><head><ref target="https://papyri.info/editions/p.lond/5/1783" n="37536"><title>P.Lond. 5 1783</title><date>1917</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><ab>
    <lb n="1"/><g type="stauros"/> 

    <lb n="1"/><g type="stauros"/> ἡ <expan>ἁγί<ex>α</ex></expan> τοῦ <expan>θ<ex>εο</ex>ῦ</expan> <expan>ἐκκλ<ex>ησία</ex></expan> <expan>Ἑρμουπόλ<ex>εως</ex></expan> διʼ <expan>ἐμο<ex>ῦ</ex></expan> Μηνᾶ

    <lb n="2"/><expan><unclear>νο</unclear>ταρ<ex>ίου</ex></expan> <expan><ex>καὶ</ex></expan> <expan>ἀπαιτη<unclear>το</unclear><ex>ῦ</ex></expan> τῷ <expan>ἀδελ<ex>φῷ</ex></expan> Ἀββᾷ <app type="editorial"><lem resp="Cf. BL 8.193 (van Minnen)"><expan><unclear>Ζ</unclear>αχαρ<ex>ίᾳ</ex></expan></lem><rdg resp="BL 8.193 (Gascou)"><unclear>Π</unclear>αχαρ</rdg><rdg>Παχαρ<unclear>ίῳ</unclear></rdg></app>. 

    <lb n="3"/><expan>δέδωκ<ex>ας</ex></expan> ἀπὸ τοῦ <expan>πάκτ<ex>ου</ex></expan> <expan>καρπ<ex>ῶν</ex></expan> πέμπτης <expan>ἰνδ<ex>ικτίονος</ex></expan> 

    <lb n="4"/><expan>χρυσο<ex>ῦ</ex></expan> <expan>κερ<ex>άτια</ex></expan> πέντε <unclear>ἥμ</unclear>ισυ, <expan>γί<ex>νεται</ex></expan> <expan>χρ<ex>υσοῦ</ex></expan> <expan>κ<ex>εράτια</ex></expan> <num value="5">ε</num> <subst><add place="inline"><num value="1/2">𐅵</num></add><del rend="corrected"><unclear>α</unclear></del></subst>, τὰ καὶ <expan>δοθ<ex>έντα</ex></expan> 

    <lb n="5"/>Μηνᾷ <expan>στρατ<ex>ιώτῃ</ex></expan> <expan><ex>ὑπὲρ</ex></expan> κε<unclear>ρατ</unclear>ίου <abbr>μ</abbr>. <expan>ἐγράφ<ex>η</ex></expan> <expan>Φ<ex>α</ex>ῶφ<ex>ι</ex></expan> <num value="29">κθ</num> <expan>ἰνδ<ex>ικτίονος</ex></expan> <num value="5">ε</num>. 

    <lb n="6"/><choice><reg>Μηνᾶς</reg><orig>Μηνᾶ</orig></choice> <expan>νοτάρ<ex>ιος</ex></expan> <expan><ex>καὶ</ex></expan> <choice><reg>ἀπαιτητὴς</reg><orig>ἀπαιτητοῦ</orig></choice> στοιχεῖ μοι ὡς <expan>πρ<ex>όκειται</ex></expan>. 

    <lb n="7"/><g type="stauros"/> Θεοδόσιος <expan>ἐγράφ<ex>η</ex></expan> <expan><unclear>δ</unclear><ex>ι</ex>ʼ</expan> <expan><unclear>ἐμ</unclear><ex>οῦ</ex></expan>. 

    <lb n="8"/><expan>ὁμοί<ex>ως</ex></expan> <expan>κερ<ex>άτια</ex></expan> δύο <expan>μ<ex>όνα</ex></expan>, <expan>γί<ex>νεται</ex></expan> <expan>κ<ex>εράτια</ex></expan> <num value="2">β</num> <expan>μ<ex>όνα</ex></expan>. <g type="stauros"/> </ab></div></body>
