      <body><head><ref target="https://papyri.info/editions/p.wuerzb/1/18" n="31529"><title>P.Würzb. 1 18</title><date>1934</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve">
<ab>
    <lb n="1"/><gap reason="lost" extent="unknown" unit="line"/> 

    <lb n="1"/><gap reason="illegible" quantity="2" unit="character"/>κτου<gap reason="illegible" quantity="12" unit="character"/> <unclear>τ</unclear>ους 

    <lb n="2"/>ἀπὸ τῆς αὐτῆς πόλεως, ἦλθεν 

    <lb n="3"/>εἴς <choice><reg>με</reg><orig>μαι</orig></choice> ἀπὸ ὀνόματος Λίλλας <choice><reg>τῆς</reg><orig>η</orig></choice> καὶ 

    <lb n="4"/>Παπιρίας <gap reason="illegible" quantity="4" unit="character"/> <expan>σπο<ex>ριμ  </ex></expan> <expan><ex>ἀρουρ  </ex></expan> <num value="19">ιθ</num> <num value="1/2">𐅵</num> καὶ τὴν 

    <lb n="5"/>νομὴν καὶ <choice><reg>δεσποτείαν</reg><orig>δεσποτίαν</orig></choice> ἔσχον. <choice><reg>ἐπεὶ</reg><orig>ἐπὶ</orig></choice> τοί

    <lb n="6" break="no"/>νυν χρὴ αὐτὸ τοῦτο γ<g type="apostrophe"/>νωσθῆναι 

    <lb n="7"/>τῇ σῇ <choice><reg>ἐμμελείᾳ</reg><orig>ἐμμελίᾳ</orig></choice>, ἔσπευσα τὴν τῶν 

    <lb n="8"/>ἐπισταλμάτων δόσιν <choice><reg>ποιήσασθαι</reg><orig>ποήσ<supplied reason="lost">α</supplied>σθαι</orig></choice> 

    <lb n="9"/><supplied reason="lost">ἀ</supplied>ξιῶν τὰς προειρημένης γᾶς 

    <lb n="10"/>κουφισθῆναι μὲν ἀπὸ τοῦ προειρη

    <lb n="11" break="no"/>μένου ὀνόματος <gap reason="lost" quantity="3" unit="character"/><gap reason="illegible" quantity="2" unit="character"/><gap reason="lost" quantity="3" unit="character"/><gap reason="illegible" quantity="5" unit="character"/> 

    <lb n="12"/>καὶ τοῦ πολιτικοῦ <choice><reg>ὑποστήματος</reg><orig>ὑποστέματος</orig></choice>, 

    <lb n="13"/>σωματισθῆναι δὲ ἐπʼ ὀνόματός 

    <lb n="14"/>μου ἐν τῷ ἡμετέρῳ πεδίῳ Ἀλα

    <lb n="15" break="no"/><supplied reason="lost">βα</supplied>νθίδ<supplied reason="lost">ος</supplied> ἀπὸ τῆς εὐτυχοῦς ὀγ<g type="apostrophe"/>δόη<supplied reason="lost">ς</supplied> 

    <lb n="16"/><expan><supplied reason="lost">ἰνδ</supplied><ex>ικτίωνος</ex></expan> <gap reason="lost" quantity="6" unit="character"/>άλυσιν τῶν ε<unclear>ὐσε</unclear><gap reason="illegible" quantity="2" unit="character"/><gap reason="lost" quantity="2" unit="character"/> 

    <lb n="17"/><app type="editorial"><lem resp="R. Mascellari, APF 64 (2018) 302"><supplied reason="lost">διε</supplied>υτύχει</lem><rdg><handShift new="m2"/> <supplied reason="lost">ε</supplied>ὐτύχει</rdg></app>. 
</ab></div></body>
