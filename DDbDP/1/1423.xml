      <body><head><ref target="https://papyri.info/editions/p.cair.zen/4/59798" n="1400"><title>P.Cair. Zen. 4 59798</title><date>1931</date></ref></head><div xml:lang="grc" type="edition" xml:space="preserve"><div n="1" type="textpart" xml:id="_1"><head>1</head><ab>

    <lb n="1"/>πρὸς Ἀμμωνίαν. 

    <lb n="2"/>ἔστιν τὸ κατὰ τὴν συγγραφὴν 

    <lb n="3"/>δάνειον <expan>ἀργυρ<ex>ίου</ex></expan> <expan><ex>δραχμαὶ</ex></expan> <num value="45">με</num> 

    <lb n="4"/>καὶ ἀλλαγὴ ἐκ <num value="2"><expan><ex>διωβόλου</ex></expan></num> <num value="1/2"><expan><ex>ἡμιωβελίου</ex></expan></num> <expan><ex>δραχμαὶ</ex></expan> <num value="4">δ</num> <num value="4"><expan><ex>τετρώβολον</ex></expan></num> 

    <lb n="5"/><expan><ex>γίνονται</ex></expan> <expan><ex>δραχμαὶ</ex></expan> <num value="49">μθ</num> <num value="4"><expan><ex>τετρώβολον</ex></expan></num> 

    <lb n="6"/>ἔχομεν δὲ παρὰ σοῦ 

    <lb n="7"/>Φαμενὼθ <num value="9">θ</num> παρόντος Ἀντιπάτρου 

    <lb n="8"/>οἴνου <expan>κο<ex>τύλας</ex></expan> <num value="8">η</num> 

    <lb n="9"/>εἰς ἀγρὸν <expan>κο<ex>τύλας</ex></expan> <num value="6">ϛ</num> 

    <lb n="10"/>καὶ Ἀντιπάτρου παρόντος 
</ab></div><div n="2" type="textpart" xml:id="_2"><head>2</head><ab>

