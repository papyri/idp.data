<div n="1" subtype="column" type="textpart"><ab>
<lb n="1"/>δέομαι <app type="editorial"><lem>κατάπαυσον</lem><rdg resp=" MSS, Vilborg">κατέπᾳσον</rdg><rdg resp="Whitmarsh">κατέπαισον</rdg></app> αὖθις καὶ
<lb n="2"/>μὴ ταχὺ τὴν <app type="editorial"><lem>ἐπωδὴν</lem><rdg resp="Vilborg">ἐπῳδὴν</rdg><rdg resp="Whitmarsh">ἐπωιδὴν</rdg></app> παραδρά
<lb n="3" break="no"/>μης <app type="editorial"><lem>καὶ</lem><rdg resp="MSS">μὴ</rdg></app> πάλιν ἀγριάνης τὸ τραῦ
<lb n="4" break="no"/>μα καὶ ἅμα λέγων τὴν χεῖρα βι
<lb n="5" break="no"/>αιότερον <app type="editorial"><lem>περιέβαλλον</lem><rdg resp="WG">περιέβαλον</rdg></app> καὶ ἐ
<lb n="6" break="no"/>φίλουν <app type="editorial"><lem>ἐλευθεριώτερον</lem><rdg resp="Cobet">ἐλευθερώτερον</rdg></app> ἡ δὲ
<lb n="7"/><g type="paragraphos"/> ἠνείχετο κωλύοσα <app type="editorial"><lem>δῆθεν</lem><rdg resp="Schmidt">μηδέν</rdg></app>
<lb n="8"/>ἐν τούτω πόρρωθεν ἰδόντες
<lb n="9"/>προσιοῦσαν τὴν θεράπαιναν
<lb n="10"/>διελύθημεν ἐγώ μέν ἄκω<g type="dash"/>
<lb n="11"/>καὶ λυπούμενος ἡ δὲ οὐκ οἶδ’ ὅ
<lb n="12" break="no"/><unclear>π</unclear>ως <app type="editorial"><lem>εἶχεν</lem><rdg resp=" MSS"> </rdg></app> <app type="editorial"><lem>ῥάων</lem><rdg resp="Vilborg">ῥᾴον</rdg></app> οὖν ἐγεγό
<lb n="13" break="no"/>νειν καὶ μεστὸς ἐλπίδων <app type="editorial"><lem>ἠ
<lb n="14" break="no"/>σθόμην</lem><rdg resp="α">ᾐ <lb n="14" break="no"/>στανόμην</rdg></app> <app type="editorial"><lem>δὲ</lem><rdg resp="W">μὲν</rdg></app> ἐπικαθημένου
<lb n="15"/>μοι τοῦ φιλήματος <app type="editorial"><lem>ὡς</lem><rdg resp="MSS">ὥσπερ</rdg></app> <app type="editorial"><lem>σώμα
<lb n="16" break="no"/>τος</lem><rdg resp="Schmidt">σήμα <lb n="16" break="no"/>τος</rdg></app> καὶ <app type="editorial"><lem>ἐφύλασσον</lem><rdg resp="MSS, Vilborg">ἐφύλαττον</rdg></app> <app type="editorial"><lem>ἀληθῶς</lem><rdg resp="MSS, Vilborg">ἀκριβῶς</rdg></app>
<lb n="17"/>ὡς θησαυρὸν τὸ φίλημα τῆρω<g type="dash"/> 
<lb n="18"/>ἡδονῆς <app type="editorial"><lem>ὅπερ</lem><rdg resp="MSS, Vilborg">ὁ </rdg></app> πρώτόν ἐστιν <app type="editorial"><lem resp="Π ">  </lem><rdg resp="MSS, Vilborg, Whitmarsh"> ἐραστῆι</rdg></app>
